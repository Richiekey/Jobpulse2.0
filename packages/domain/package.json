{
  "name": "@jobpulse/domain",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./location-parser": {
      "types": "./dist/location-parser.d.ts",
      "import": "./dist/location-parser.js",
      "default": "./dist/location-parser.js"
    },
    "./skills-taxonomy": {
      "types": "./dist/skills-taxonomy.d.ts",
      "import": "./dist/skills-taxonomy.js",
      "default": "./dist/skills-taxonomy.js"
    },
    "./salary-estimator": {
      "types": "./dist/salary-estimator.d.ts",
      "import": "./dist/salary-estimator.js",
      "default": "./dist/salary-estimator.js"
    },
    "./normalizer": {
      "types": "./dist/normalizer.d.ts",
      "import": "./dist/normalizer.js",
      "default": "./dist/normalizer.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@jobpulse/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
